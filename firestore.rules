rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ▼ リストを作成できるのは、この Google アカウントだけ（あなた自身のアドレスに書き換える・小文字）
    //   ※ 実際のアドレスは Firebase コンソールにだけ貼り、このファイル（公開リポジトリ）には書かない
    //   ほかの人は、招待リンク＋Google ログインで参加する（承認なし・1つのリストに最大10人）
    function ownerEmail() {
      return 'you@example.com';
    }
    function maxMembers() { return 10; }

    function signedIn() { return request.auth != null; }
    function isOwnerAccount() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == ownerEmail();
    }
    function spaceData(spaceId) {
      return get(/databases/$(database)/documents/spaces/$(spaceId)).data;
    }
    function isMember(spaceId) {
      return signedIn() && request.auth.uid in spaceData(spaceId).members;
    }

    match /spaces/{spaceId} {
      // リストの中身はメンバーだけが読める（リストの一覧取得は禁止）
      allow get: if signedIn() && request.auth.uid in resource.data.members;

      // リストを作れるのは作成者のアカウントだけ。作成時のメンバーは自分1人
      allow create: if isOwnerAccount()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      allow update: if signedIn() && (
        (request.resource.data.get('ownerUid', null) == resource.data.get('ownerUid', null)
          && (
            // メンバー：メンバー構成を変えない更新（選択肢・名前・招待コードなど）
            (request.auth.uid in resource.data.members
              && request.resource.data.members == resource.data.members)
            // 招待リンク：有効な招待コードを添えて、自分を追加する（上限まで）
            || (!(request.auth.uid in resource.data.members)
              && resource.data.members.size() < maxMembers()
              && resource.data.get('inviteCode', null) is string
              && resource.data.inviteCode.size() >= 20
              && request.resource.data.get('joinCode', null) == resource.data.inviteCode
              && request.resource.data.members == resource.data.members.concat([request.auth.uid])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinCode']))
            // 作成者：ほかのメンバーを1人外す（作成者自身は残る）
            || (request.auth.uid == resource.data.get('ownerUid', null)
              && request.auth.uid in request.resource.data.members
              && resource.data.members.hasAll(request.resource.data.members)
              && request.resource.data.members.size() == resource.data.members.size() - 1)
            // 作成者以外のメンバー：自分がリストから抜ける（最後の1人は抜けられない）
            || (request.auth.uid in resource.data.members
              && request.auth.uid != resource.data.get('ownerUid', null)
              && !(request.auth.uid in request.resource.data.members)
              && resource.data.members.hasAll(request.resource.data.members)
              && request.resource.data.members.size() == resource.data.members.size() - 1
              && request.resource.data.members.size() >= 1
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberInfo']))
          ))
        // 古い版で作ったリスト（作成者の記録がない）：作成者のアカウントが、自分を作成者として登録する
        || (resource.data.get('ownerUid', null) == null
          && isOwnerAccount()
          && request.auth.uid in resource.data.members
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.members == resource.data.members)
      );
      allow delete: if false;

      match /shops/{shopId} {
        allow read, write: if isMember(spaceId);
      }
    }

    // 自分がどのリストに入っているかの記録。書き込めるのはメンバーになった後だけ（削除は本人ならいつでも）
    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && isMember(request.resource.data.spaceId);
    }
  }
}
