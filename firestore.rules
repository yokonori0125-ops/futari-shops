rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ▼ ここに使う2人の Google アカウントのメールアドレスを書く（小文字）
    //   ※ 実際のアドレスは Firebase コンソールにだけ貼り、このファイル（公開リポジトリ）には書かない
    function allowedEmails() {
      return ['you@example.com', 'partner@example.com'];
    }

    // 許可されたアカウントでログインしているか
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in allowedEmails();
    }
    function isMember(spaceId) {
      return allowed() &&
        request.auth.uid in get(/databases/$(database)/documents/spaces/$(spaceId)).data.members;
    }

    match /spaces/{spaceId} {
      // 部屋の中身はメンバーだけが読める（部屋の一覧取得は禁止）
      allow get: if allowed() && request.auth.uid in resource.data.members;
      // 作成時のメンバーは自分1人だけ
      allow create: if allowed() && request.resource.data.members == [request.auth.uid];
      allow update: if allowed() && (
        // メンバーはメンバー構成以外を変更できる
        (request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members)
        // 招待された人は、2人目として自分を追加することだけができる
        || (!(request.auth.uid in resource.data.members)
          && resource.data.members.size() < 2
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']))
      );
      allow delete: if false;

      match /shops/{shopId} {
        allow read, write: if isMember(spaceId);
      }
    }

    match /users/{uid} {
      allow read, write: if allowed() && request.auth.uid == uid;
    }
  }
}
